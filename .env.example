# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_KEY=change-me-to-a-long-random-string
LOG_LEVEL=info
TZ=Africa/Lagos

# ── Database ──────────────────────────────────────────
DATABASE_URL="file:./courtside.db"
# DATABASE_URL="postgresql://user:pass@localhost:5432/courtside?schema=public"

# ── Analysis window ───────────────────────────────────
ANALYSIS_WINDOW_HOURS=24
LEAGUES_ENABLED=WNBA,NBA

# ── Availability gate (spec §4.3) ─────────────────────
MIN_MINUTES_THRESHOLD=8.0
LAYOFF_DAYS=14
MAX_GAMES_MISSED_L15=4
EXCLUDE_PROBABLE=false
EXCLUDE_QUESTIONABLE=true

# ── Form & line selection (spec §4.4-4.5) ─────────────
PRIMARY_WINDOW=5
HIT_RATE_THRESHOLD=4
RECENCY_LAMBDA=0.85
SELECTION_MODE=BALANCED
MIN_GAMES_REQUIRED=5
COMPUTE_UNDER_SIDE=true
DISPLAY_SIDE_DEFAULT=OVER

# ── Confidence (spec §4.6) ────────────────────────────
CONFIDENCE_FLOOR=55
SCORING_CONFIG_PATH=./src/config/scoring.json

# ── Sources ───────────────────────────────────────────
BETANO_BASE_URL=https://www.betano.ng
BETANO_CONFIG_PATH=./src/config/betano.json
BETANO_MIN_DELAY_MS=2000
BETANO_MAX_DELAY_MS=5000
BETANO_USE_BROWSER=true
PLAYWRIGHT_USER_DATA_DIR=./.pw-profile
PLAYWRIGHT_HEADLESS=true

# ── Semi-manual Cloudflare session replay ─────────────
# Confirmed 22 Jul 2026: Cloudflare fingerprints Playwright automation itself,
# not just "is this a browser" — so a scripted browser gets 403'd the same as
# a bare HTTP client. The working alternative: capture a session from YOUR
# OWN normal browser and replay it as plain HTTP (no automation involved).
#
# How to capture (repeat whenever the direct tier starts failing again —
# expect anywhere from ~30 minutes to a few hours before it needs refreshing):
#   1. Open betano.ng in Chrome/Edge normally, browse to a fixture, open Players
#   2. F12 → Network tab → click any request to betano.ng
#   3. Headers → Request Headers → copy the ENTIRE "Cookie" value below
#   4. Same request → copy the exact "User-Agent" value below
#      (must be from the SAME request as the cookie — Cloudflare ties the
#      clearance cookie to the exact User-Agent that solved the challenge)
# Repeat for sofascore.com if SofaScore also 403s.
BETANO_SESSION_COOKIE=
BETANO_SESSION_USER_AGENT=
SOFASCORE_SESSION_COOKIE=
SOFASCORE_SESSION_USER_AGENT=

# www.sofascore.com is confirmed reachable with a captured session (22 Jul
# 2026) — api.sofascore.com 403'd even with a fresh, valid cookie. Same-origin
# with the site the cookie was captured from is very likely why.
# ── Static SofaScore tournament + season IDs ──────────────
# Neither is resolved live (spec §5.3.4) — the catalogue/season-list endpoints
# were never confirmed working and 403 under the same session every tested
# endpoint succeeds with. Tournament ID is stable and doesn't need renewing;
# season ID rolls over yearly, hence the EXPIRES check: past that date, the
# app refuses to start rather than silently drifting to last season's data.
#
# WNBA tournament ID confirmed 22 Jul 2026: 486
WNBA_SOFASCORE_TOURNAMENT_ID=486
NBA_SOFASCORE_TOURNAMENT_ID=

# Get season IDs by running: npm run sofascore:resolve-season -- --league WNBA
NBA_SOFASCORE_SEASON_ID=
NBA_SOFASCORE_SEASON_EXPIRES=
WNBA_SOFASCORE_SEASON_ID=
WNBA_SOFASCORE_SEASON_EXPIRES=

SOFASCORE_BASE_URL=https://www.sofascore.com/api/v1
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/basketball
ESPN_SUMMARY_BASE_URL=https://site.web.api.espn.com/apis/site/v2/sports/basketball

# ── Alerts ────────────────────────────────────────────
ALERT_WEBHOOK_URL=
