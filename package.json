{
  "name": "courtside-api",
  "version": "1.0.0",
  "private": true,
  "description": "Courtside \u2014 NBA & WNBA player props analysis engine (backend)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "tsx src/jobs/scheduler.ts",
    "analyse": "tsx src/scripts/analyse.ts",
    "settle": "tsx src/scripts/settle.ts",
    "discover:betano": "tsx src/scripts/discover-betano.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "bootstrap": "tsx src/scripts/bootstrap.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "demo": "tsx src/scripts/demo.ts",
    "discover:har": "tsx src/scripts/discover-har.ts",
    "test:session": "tsx src/scripts/test-session.ts",
    "test:squad": "tsx src/scripts/test-sofascore-squad.ts",
    "sofascore:resolve-season": "tsx src/scripts/resolve-season.ts",
    "debug:betano-raw": "tsx src/scripts/dump-betano-raw.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "undici": "^6.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  }
}